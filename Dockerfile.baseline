# Intentionally insecure evaluation fixture. Keep deployment local.
FROM python:3.10.0
WORKDIR /app
COPY requirements-baseline.txt ./requirements.txt
RUN pip install -r requirements.txt
COPY app/ ./
COPY fixtures/dummy-secret.txt /app/dummy-secret.txt
EXPOSE 8080
CMD ["gunicorn", "--bind", "0.0.0.0:8080", "app:create_app()"]
